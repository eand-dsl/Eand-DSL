{
  "name": "@eand/react-design-system",
  "version": "1.0.0",
  "description": "e& Consumer App design system — web React components for Figma Make",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "MAKE_KIT_GUIDELINES.md",
    "MAKE_KIT_README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build:tokens": "tsx scripts/build-tokens.ts",
    "build": "npm run build:tokens && vite build && tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite",
    "playground": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.code-connect.json",
    "test": "vitest run",
    "codeconnect:check": "figma connect publish --dry-run",
    "codeconnect:publish": "figma connect publish",
    "guidelines:facts": "tsx scripts/guidelines-facts.ts",
    "guidelines:check": "tsx scripts/check-guidelines.ts",
    "guidelines:example": "tsx scripts/check-example.ts",
    "smoke": "node scripts/smoke-esm.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^24.0.0",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^18.3.1",
    "style-dictionary": "^4.0.1",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
