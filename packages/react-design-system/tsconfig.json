{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  // MUST stay "src" only. `tsc --emitDeclarationOnly --outDir dist` infers its root from
  // the widest included path, so adding code-connect here emits dist/src/index.d.ts and
  // package.json's "types": "./dist/index.d.ts" then resolves to nothing — consumers
  // silently fall back to inferred `any` types. Code Connect files are typechecked by
  // tsconfig.typecheck.json instead (see the `typecheck` script), along with demo/.
  // test-setup.ts is vitest scaffolding (vite.config.ts loads it by path, not by this
  // config), so it must not reach the published dist/ as a stray .d.ts.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-setup.ts", "scripts"]
}
